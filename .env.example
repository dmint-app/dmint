# Dmint Environment Configuration
# ===============================

# Core Runtime & Enforcement
# --------------------------
# Enforcement mode for coding-agent hooks: enforce (default) or shadow.
# In shadow mode, would-be blocks are recorded in .dmint/audit.jsonl without blocking.
# DMINT_MODE=enforce

# Minimum audit log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL (default: INFO).
# DMINT_LOG_LEVEL=INFO

# Pinned SHA-256 digest of policy.json (64 lowercase hex characters).
# Recommended in production; startup/reload halts if the file digest does not match.
# DMINT_EXPECTED_POLICY_DIGEST=

# Deployment epoch/namespace for approval records (default: default).
# Rotate to invalidate approvals from a previous deployment lifecycle.
# DMINT_DEPLOYMENT_EPOCH=default

# Ed25519 private signing key for the approval authority (mode 0600).
# Defaults to ~/.config/dmint/signing.key when unset.
# DMINT_KEY_FILE=/etc/dmint/authority/signing.key

# HMAC-SHA256 integrity key for approval-row integrity (mode 0600/0400).
# Defaults to ~/.config/dmint/integrity.key when unset.
# DMINT_INTEGRITY_KEY_FILE=/etc/dmint/shared/integrity.key

# Database Connection URL (Pluggable Storage)
# -------------------------------------------
# Unset / empty: Defaults to local SQLite file storage (zero external dependencies).
# Ideal for local development, CLI usage, and CI runs.
# DMINT_DATABASE_URL=

# Production: PostgreSQL
# Set to a postgresql:// URL to persist all approvals in PostgreSQL.
# Supports connection pooling, row-level locking (SELECT ... FOR UPDATE), and high-concurrency environments.
# DMINT_DATABASE_URL=postgresql://dmint_user:secure_password@localhost:5432/dmint_prod

# Alternative SQLite URL format (optional explicit path)
# DMINT_DATABASE_URL=sqlite:///path/to/approvals.sqlite

# Outgoing Approval Webhooks (Notifications)
# ------------------------------------------
# Dispatches instant human-readable notifications when an action requires approval.
# Either, any, or none may be set. If none are set, webhook dispatch is a no-op.
# Webhook failures NEVER disrupt or block authorization decisions (fire-and-forget).

# Slack Incoming Webhook
# Format: https://hooks.slack.com/services/<TEAM_ID>/<CHANNEL_ID>/<TOKEN>
# DMINT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<TEAM_ID>/<CHANNEL_ID>/<TOKEN>

# Discord Incoming Webhook
# Format: https://discord.com/api/webhooks/123456789/abcdef-xyz
# DMINT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz_0123456789

# Microsoft Teams Incoming Webhook (or Power Automate / Workflows URL)
# Format: https://outlook.office.com/webhook/... or https://prod-XX.location.logic.azure.com/...
# DMINT_TEAMS_WEBHOOK_URL=https://example.webhook.office.com/webhookb2/00000000-0000-0000-0000-000000000000/IncomingWebhook/xxxxxxxx/00000000-0000-0000-0000-000000000000

# Webhook Request Timeout (seconds, default: 3.0)
# DMINT_WEBHOOK_TIMEOUT=3.0
