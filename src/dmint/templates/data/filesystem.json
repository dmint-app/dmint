{
  "rules": [
    {
      "effect": "allow",
      "tool": "filesystem",
      "action": "read_file",
      "resource": "src/*",
      "resource_kind": "path"
    },
    {
      "effect": "allow",
      "tool": "filesystem",
      "action": "read_file",
      "resource": "docs/*",
      "resource_kind": "path"
    },
    {
      "effect": "allow",
      "tool": "filesystem",
      "action": "read_file",
      "resource": "tests/*",
      "resource_kind": "path"
    },
    {
      "effect": "allow",
      "tool": "filesystem",
      "action": "list_directory",
      "resource": "*",
      "resource_kind": "path"
    },
    {
      "effect": "approval_required",
      "tool": "filesystem",
      "action": "write_file",
      "resource": "src/*",
      "resource_kind": "path"
    },
    {
      "effect": "approval_required",
      "tool": "filesystem",
      "action": "create_directory",
      "resource": "*",
      "resource_kind": "path"
    },
    {
      "effect": "approval_required",
      "tool": "filesystem",
      "action": "delete_file",
      "resource": "*",
      "resource_kind": "path"
    },
    {
      "effect": "deny",
      "tool": "filesystem",
      "action": "read_file",
      "resource": ".env*",
      "resource_kind": "path"
    },
    {
      "effect": "deny",
      "tool": "filesystem",
      "action": "read_file",
      "resource": "*.key",
      "resource_kind": "path"
    },
    {
      "effect": "deny",
      "tool": "filesystem",
      "action": "read_file",
      "resource": "*.pem",
      "resource_kind": "path"
    },
    {
      "effect": "deny",
      "tool": "filesystem",
      "action": "read_file",
      "resource": "/etc/*",
      "resource_kind": "path"
    },
    {
      "effect": "deny",
      "tool": "filesystem",
      "action": "write_file",
      "resource": ".env*",
      "resource_kind": "path"
    },
    {
      "effect": "deny",
      "tool": "filesystem",
      "action": "write_file",
      "resource": "/etc/*",
      "resource_kind": "path"
    }
  ],
  "strict_arguments": false
}
