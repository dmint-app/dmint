{
  "rules": [
    {
      "effect": "allow",
      "tool": "shell",
      "action": "execute",
      "resource": "git status",
      "resource_kind": "exact"
    },
    {
      "effect": "allow",
      "tool": "shell",
      "action": "execute",
      "resource": "git diff",
      "resource_kind": "exact"
    },
    {
      "effect": "allow",
      "tool": "shell",
      "action": "execute",
      "resource": "git log",
      "resource_kind": "exact"
    },
    {
      "effect": "allow",
      "tool": "shell",
      "action": "execute",
      "resource": "npm test",
      "resource_kind": "exact"
    },
    {
      "effect": "allow",
      "tool": "shell",
      "action": "execute",
      "resource": "pytest",
      "resource_kind": "exact"
    },
    {
      "effect": "allow",
      "tool": "shell",
      "action": "execute",
      "resource": "cargo test",
      "resource_kind": "exact"
    },
    {
      "effect": "allow",
      "tool": "shell",
      "action": "execute",
      "resource": "ls",
      "resource_kind": "exact"
    },
    {
      "effect": "allow",
      "tool": "shell",
      "action": "execute",
      "resource": "ls *",
      "resource_kind": "exact"
    },
    {
      "effect": "allow",
      "tool": "shell",
      "action": "execute",
      "resource": "pwd",
      "resource_kind": "exact"
    },
    {
      "effect": "approval_required",
      "tool": "shell",
      "action": "execute",
      "resource": "git push *",
      "resource_kind": "exact"
    },
    {
      "effect": "approval_required",
      "tool": "shell",
      "action": "execute",
      "resource": "systemctl *",
      "resource_kind": "exact"
    },
    {
      "effect": "approval_required",
      "tool": "shell",
      "action": "execute",
      "resource": "docker *",
      "resource_kind": "exact"
    },
    {
      "effect": "approval_required",
      "tool": "shell",
      "action": "execute",
      "resource": "kill *",
      "resource_kind": "exact"
    },
    {
      "effect": "approval_required",
      "tool": "shell",
      "action": "execute",
      "resource": "npm install *",
      "resource_kind": "exact"
    },
    {
      "effect": "approval_required",
      "tool": "shell",
      "action": "execute",
      "resource": "pip install *",
      "resource_kind": "exact"
    },
    {
      "effect": "deny",
      "tool": "shell",
      "action": "execute",
      "resource": "rm -rf /",
      "resource_kind": "exact"
    },
    {
      "effect": "deny",
      "tool": "shell",
      "action": "execute",
      "resource": "rm -rf /*",
      "resource_kind": "exact"
    },
    {
      "effect": "deny",
      "tool": "shell",
      "action": "execute",
      "resource": "mkfs *",
      "resource_kind": "exact"
    },
    {
      "effect": "deny",
      "tool": "shell",
      "action": "execute",
      "resource": "dd *",
      "resource_kind": "exact"
    },
    {
      "effect": "deny",
      "tool": "shell",
      "action": "execute",
      "resource": "* | sh",
      "resource_kind": "exact"
    },
    {
      "effect": "deny",
      "tool": "shell",
      "action": "execute",
      "resource": "* | bash",
      "resource_kind": "exact"
    }
  ],
  "strict_arguments": false
}
