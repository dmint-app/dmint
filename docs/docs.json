{
  "$schema": "https://holocron.so/docs.json",
  "name": "Dmint",
  "colors": {
    "primary": "#10b981",
    "light": "#34d399",
    "dark": "#059669"
  },
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo-dark.svg",
    "text": "dmint",
    "href": "https://dmint.app"
  },
  "layout": {
    "mode": "compact"
  },
  "decorativeLines": "none",
  "assistant": {
    "enabled": false
  },
  "fonts": {
    "family": "Outfit",
    "heading": {
      "family": "Outfit",
      "weight": 600
    }
  },
  "favicon": "/logo.svg",
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/dmint-app"
      },
      {
        "label": "PyPI",
        "href": "https://pypi.org/project/dmint/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Tutorials",
        "pages": [
          "tutorials/protect-a-tool"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "concepts/how-dmint-works",
          "concepts/policies",
          "concepts/request-binding",
          "concepts/approvals",
          "concepts/resources"
        ]
      },
      {
        "group": "How-To Guides",
        "pages": [
          "guides/coding-agent-hooks",
          "guides/python-integration",
          "guides/protecting-mcp",
          "guides/human-approvals",
          "guides/notifications",
          "guides/authoring-policies",
          "guides/agent-skills"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/claude-code",
          "integrations/codex",
          "integrations/opencode",
          "integrations/cursor",
          "integrations/windsurf-cline",
          "integrations/antigravity",
          "integrations/custom-agents"
        ]
      },
      {
        "group": "Operations & Security",
        "pages": [
          "operations/deployment-model",
          "operations/security-model",
          "operations/known-limitations"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/core-api",
          "reference/policy-schema",
          "reference/policy-templates",
          "reference/mcp-protection-schema",
          "reference/errors"
        ]
      },
      {
        "group": "Help & FAQ",
        "pages": [
          "troubleshooting",
          "faq"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/dmint-app",
      "x": "https://x.com/dmint_app"
    }
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-W7EBSH066H"
    }
  },
  "customCss": "img[src*='logo'], .dark [class*='invert'], [class*='dark:invert'] { filter: none !important; } footer div.opacity-40, footer div:has(a[href*='holocron.so']), a[href*='holocron.so'] { display: none !important; } button[title='Copy page as Markdown'] { display: none !important; } div[class*='grid-lines'], div[class*='decorative-lines'] { display: none !important; }"
}
